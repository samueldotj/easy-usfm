# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# --- Frontend (Svelte + Vite) ---
node_modules/
dist/
dist-ssr/
.vite/
*.local

# --- Tauri ---
src-tauri/target/
crates/*/target/
gen/

# --- WASM build output ---
pkg/
*.wasm

# --- Test corpus (vendored by hash; see docs/ARCHITECTURE.md 12.4) ---
# Corpus files are committed deliberately once licence-audited.
# Fuzz artefacts and benchmark output are not.
fuzz/artifacts/
fuzz/corpus/
fuzz/target/
criterion/

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# --- Test corpus ---
# Core tier is committed; extended tier is fetched (see corpus/README.md).
corpus/extended/
corpus/.catalog.csv

# --- Python tooling ---
__pycache__/
*.py[cod]
